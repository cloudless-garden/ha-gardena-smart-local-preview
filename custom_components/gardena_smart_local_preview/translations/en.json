  "services": {
    "open_valve": {
      "name": "Open valve",
      "description": "Opens a valve, optionally overriding its configured duration for this call only.",
      "fields": {
        "duration": {
          "name": "Duration",
          "description": "How long to keep the valve open, in seconds (60-10800). Defaults to the valve's configured duration if omitted."
        }
      }
    },
    "enable_output": {
      "name": "Enable output",
      "description": "Enables the output of a power outlet for a fixed duration, optionally overriding its configured duration for this call only. The output is disabled automatically once that duration has elapsed.",
      "fields": {
        "duration": {
          "name": "Duration",
          "description": "How long to keep the outlet on, in seconds (minimum 1). Defaults to the outlet's configured duration if omitted."
        }
      }
    },
    "start_pump": {
      "name": "Start pump",
      "description": "Starts a pump for a fixed duration, optionally overriding its configured duration for this call only. The pump stops automatically once that duration has elapsed.",
      "fields": {
        "duration": {
          "name": "Duration",
          "description": "How long to run the pump, in seconds (60-5400). Defaults to the pump's configured duration if omitted."
        }
      }
    },
    "start_mowing": {
      "name": "Start mowing",
      "description": "Starts mowing for a fixed duration, optionally overriding the configured default duration for this call only.",
      "fields": {
        "duration": {
          "name": "Duration",
          "description": "How long to mow, in whole hours (1-6). Defaults to the entity's configured duration if omitted."
        }
      }
    }
  },
  "issues": {
    "exclude_failed": {
      "title": "Could not remove {device_id} from the gateway",
      "description": "Home Assistant removed the device, but the gateway did not confirm the exclusion, so the device may still be paired with the gateway. If it is, the device shows up in Home Assistant again the next time the gateway reports it. Remove it again while the gateway is online. To remove it without Home Assistant, reset the device as described in its manual."
    }
  },
