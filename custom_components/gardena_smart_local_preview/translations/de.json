      "fields": {
        "duration": {
          "name": "Dauer",
          "description": "Wie lange die Steckdose eingeschaltet bleibt, in Sekunden (mindestens 1). Ohne Angabe wird die konfigurierte Dauer der Steckdose verwendet."
        }
      }
    },
    "start_pump": {
      "name": "Pumpe starten",
      "description": "Startet eine Pumpe für eine feste Dauer, optional abweichend von der konfigurierten Dauer. Die Pumpe stoppt automatisch, sobald diese Dauer abgelaufen ist.",
      "fields": {
        "duration": {
          "name": "Dauer",
          "description": "Wie lange die Pumpe läuft, in Sekunden (60-5400). Ohne Angabe wird die konfigurierte Dauer der Pumpe verwendet."
        }
      }
    },
    "start_mowing": {
      "name": "Mähen starten",
      "description": "Startet den Mähvorgang für eine feste Dauer, optional abweichend von der konfigurierten Dauer.",
      "fields": {
        "duration": {
          "name": "Dauer",
          "description": "Wie lange gemäht wird, in ganzen Stunden (1-6). Ohne Angabe wird die für die Entität konfigurierte Dauer verwendet."
        }
      }
    }
  },
  "issues": {
    "exclude_failed": {
      "title": "{device_id} konnte nicht vom Gateway entfernt werden",
      "description": "Home Assistant hat das Gerät entfernt, aber das Gateway hat den Ausschluss nicht bestätigt. Das Gerät ist daher möglicherweise noch mit dem Gateway gekoppelt. In diesem Fall erscheint es wieder in Home Assistant, sobald das Gateway es das nächste Mal meldet. Entferne es dann erneut, während das Gateway online ist. Um es ohne Home Assistant zu entfernen, setze das Gerät wie in seiner Anleitung beschrieben zurück."
    }
  },
